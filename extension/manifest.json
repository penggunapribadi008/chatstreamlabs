{
  "manifest_version": 3,
  "name": "ChatStream Labs - Pengirim Chat",
  "version": "15.1.2",
  "description": "Mengirim chat dari aplikasi ChatStream Labs ke halaman live YouTube / TikTok / Twitch / Kick yang sedang kamu buka di Chrome.",
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/live_chat*"
      ],
      "js": [
        "yt.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.tiktok.com/*/live*"
      ],
      "js": [
        "tt.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "tw.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://kick.com/*",
        "https://www.kick.com/*"
      ],
      "js": [
        "kk.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
