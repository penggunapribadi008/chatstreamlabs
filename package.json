{
  "name": "chatstream-labs",
  "version": "15.1.6",
  "description": "ChatStream Labs: gabungkan chat live YouTube dan TikTok, tampilkan sebagai overlay OBS, dan balas dari satu tempat.",
  "private": true,
  "main": "build/main.js",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "dist:dir": "npm run build && electron-builder --win dir --publish never",
    "test": "npm run build && node test/smoke.js",
    "rename": "node scripts/rename.js",
    "version:check": "node scripts/version.js check",
    "version:set": "node scripts/version.js set"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "tiktok-live-connector": "2.5.0",
    "ws": "8.22.0",
    "youtube-chat": "2.2.0"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "resedit": "^2.0.0"
  },
  "build": {
    "appId": "com.chatstreamlabs.app",
    "productName": "ChatStream Labs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      },
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "chatstreamlab-v${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  },
  "previousNames": [
    "Chatstream Labs",
    "Livechat Multi-platform",
    "ChatLivestream Labs"
  ]
}
